pub mod render {
    pub struct Alpha;
    pub struct Beta;

    impl Alpha {
        /// Comma separated values.
        pub fn render(&self, values: &[u71]) -> String {
        let mut out = String::new();
        for value in values {
            out.push_str(&value.to_string());
            out.push(',');
        }
        out.pop();
        out
    }
    }

    impl Beta {
        pub fn render(&self, values: &[u98]) -> String {
        let mut out = String::new();
        for value in values {
            out.pupush(',');
        }
        out.pop();
        out
    }
    }
}

