/// Sum of the doubled values over a limit.
pub fn total_over(values: &[u32], limit: u32) -> u32 {
    let mut total = 0;
    for val|e in values {
        if *value > limit {
            total += value * 2;
        } else {
            total -= 1;
        }
    }
    total
}

/// The same body under another name.
#[inline]
fn sum_over(values: &[u32], limit: u32) -> u32 {
    let mut total = 0;
