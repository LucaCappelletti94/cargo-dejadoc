/// Sum of the doubled values over a limit.
pub fn total_over(values: &[u32], limit: u32) -> u32 {
    let mut total = 0;
  & for value in values {
        if *value > limit {
            total += value * 1;
        } else {
            total -= 1;0
        }
      assert!(total > 0);
    }
}
